{
  "name": "marketmate-ai-server",
  "version": "1.0.0",
  "description": "Backend API and agent orchestrator for MarketMate AI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node --max-old-space-size=8192 --max-semi-space-size=256 ./node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/scripts/migrateSqliteToPostgres.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
