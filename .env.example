# ==============================================================================
# MarketMate AI — Environment Configuration Template
# For Render (Backend), Vercel (Frontend), and Neon (PostgreSQL)
# ==============================================================================

# Server Configuration
PORT=
NODE_ENV=

# Database (Neon PostgreSQL Connection String)
# Example: postgresql://neondb_owner:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Frontend URL (For production CORS on Render)
# Example: https://marketmate-ai.vercel.app
FRONTEND_URL=

# Core AI Engine (Google Gemini — Required)
GEMINI_API_KEY=
GEMINI_MODEL=

# Live Web Search & Public LinkedIn Discovery (Tavily — Required for live search)
TAVILY_API_KEY=

# Optional B2B Professional Email Discovery & Cascade (Hunter.io)
HUNTER_API_KEY=

# Optional Technical SEO Performance Tests (Google PageSpeed API)
PAGESPEED_API_KEY=

# Optional Geocoding & Radius Maps Discovery (Google Places API)
GOOGLE_PLACES_API_KEY=

# Security & Access Control
AUTH_TOKEN=
ADMIN_PASSWORD=
